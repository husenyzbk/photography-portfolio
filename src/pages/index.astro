---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Contact from '../components/Contact.astro';
import { CATEGORIES, SITE } from '../consts';
import { allPhotos, coverFor, heroPhoto, heroMobilePhoto } from '../lib/photos';

const photos = allPhotos();

// The dedicated hero photograph. Until one is set it falls back to the first
// photo on the site, which is why the hero currently doubles as a category
// cover and changes whenever an earlier-sorting photo is imported.
const hero = heroPhoto() ?? photos[0];

/*
  A phone may have its own hero, which needs a real <picture> with a media
  condition: Astro's <Image> can resize one photograph, but choosing a
  *different* photograph per screen is art direction, and only <source media>
  does that. So the variants are generated here and the markup written by hand.

  The phone's widths stop at 1200: a portrait phone is rarely more than 430
  CSS px across, so 1200 already covers a 3x screen and anything beyond it is
  downloaded and thrown away.
*/
const heroMobile = heroMobilePhoto();

const heroDesktopAvif = hero
  ? await getImage({ src: hero.src, widths: [640, 1024, 1600, 2000], format: 'avif', quality: 64 })
  : undefined;

const heroMobileAvif = heroMobile
  ? await getImage({ src: heroMobile.src, widths: [480, 800, 1200], format: 'avif', quality: 64 })
  : undefined;

// The link-preview image: what renders when the Instagram bio link gets
// shared or unfurled elsewhere. 1200x630 is the size every platform crops to.
const og = hero
  ? await getImage({
      src: hero.src,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpg',
      quality: 76,
    })
  : undefined;
---

<Base ogImage={og?.src} navOverImage={Boolean(hero)}>
  {
    hero && (
      <section class="hero panel" style="--panel-z:1">
        <div class="hero__media">
          <picture>
            {
              heroMobileAvif && (
                <source
                  media="(max-width: 46rem)"
                  srcset={heroMobileAvif.srcSet.attribute}
                  sizes="100vw"
                  type="image/avif"
                />
              )
            }
            <source
              srcset={heroDesktopAvif.srcSet.attribute}
              sizes="100vw"
              type="image/avif"
            />
            <img
              src={heroDesktopAvif.src}
              alt={hero.alt}
              width={hero.src.width}
              height={hero.src.height}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="hero__img"
            />
          </picture>
        </div>

        <div class="hero__scrim" />

        <div class="shell hero__content">
          <h1 class="hero__title">{SITE.title}</h1>
          <p class="hero__tagline">{SITE.tagline}</p>
        </div>

        {/* A link, not decoration: it says what it does, and clicking it does
            it. #about is the panel immediately below. */}
        <a class="cue" href="#about" data-press="subtle">
          <span class="cue__label">Scroll</span>
          <svg class="cue__chevron" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.8" fill="none"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </section>
    )
  }

  {
    !hero && (
      <section class="shell empty">
        <h1 class="empty__title">No photos yet</h1>
        <p class="empty__body">The first photographs are on their way.</p>
      </section>
    )
  }

  {/* Replace this text with your own — see src/pages/index.astro */}
  <section class="bio panel" id="about" style="--panel-z:2">
    <div class="shell">
    <p class="eyebrow" data-reveal>About</p>
    <p class="bio__lead" data-reveal style="--reveal-delay:120ms">
      I'm an engineer in Paris who takes photos — mostly of
      animals, people, and whatever the outdoors puts in front of me.
    </p>
    <p class="bio__body" data-reveal style="--reveal-delay:220ms">
      The camera started as something to do on weekends and turned into the
      reason I go places. Most of what is here was taken on foot, without a
      plan, waiting for something to happen.
    </p>
    </div>
  </section>

  <section class="work panel" style="--panel-z:3">
    <div class="shell">
      <p class="eyebrow" data-reveal>Selected work</p>
      <div class="work__grid">
        {
          CATEGORIES.map((category, i) => (
            <CategoryCard
              category={category}
              path={[category.slug]}
              cover={coverFor([category.slug])}
              index={i}
            />
          ))
        }
      </div>
    </div>
  </section>

  <Contact />
</Base>

<style>
  /* ---------------------------------------------------------------- hero */
  /* Pinning comes from .panel. The hero only adds its own framing: a fixed
     screen height and a clipped, full-bleed photograph. */
  .hero {
    /* max() rather than a bare 32rem: a component-scoped rule outranks the
       shared .panel selector, so a plain min-height here would override the
       panel's full-screen height and leave the hero a half-screen band. The
       32rem floor still applies on short screens, where panels go static. */
    min-height: max(32rem, 100svh);
    overflow: hidden;
    /* The photo fills the panel rather than being centred inside it. */
    justify-content: flex-start;
    background: none;
  }

  .hero__media { position: absolute; inset: 0; }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-settle 1.6s var(--ease) both;
  }

  /* A slow, barely-there push in. Scale only — no layout cost. */
  @keyframes hero-settle {
    from { transform: scale(1.06); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  /* No beige melt any more — the page slides over the hero, so there is no
     edge to disguise. What is left only darkens the image enough for the white
     name and the nav links to stay readable over it. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(10, 9, 8, 0.58) 0%,
        rgba(10, 9, 8, 0.3) 34%,
        rgba(10, 9, 8, 0.06) 62%,
        transparent 82%
      ),
      linear-gradient(to bottom, rgba(10, 9, 8, 0.42) 0%, transparent 28%);
  }

  .hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(5rem, 16vh, 9rem);
    color: var(--on-image);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 9vw, 6.5rem);
    letter-spacing: -0.005em;
    line-height: 0.95;
    animation: rise 1s var(--ease) 0.25s both;
  }

  .hero__tagline {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--on-image-muted);
    animation: rise 1s var(--ease) 0.4s both;
  }

  @keyframes rise {
    from { opacity: 0; transform: translate3d(0, 24px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  /* Centred with auto margins, not translateX(-50%). The press effect and the
     entrance animation both write `transform`, and either would have wiped out
     a centring transform and thrown the cue sideways by half its width. */
  .cue {
    position: absolute;
    left: 0;
    right: 0;
    width: fit-content;
    margin-inline: auto;
    bottom: clamp(1.25rem, 3vh, 2rem);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;

    color: var(--on-image);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
    animation: cue-appear 1s var(--ease) 1.1s both;
  }

  .cue__label {
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  /* A repeated nudge downwards. Transform and opacity only, so it costs
     nothing to run continuously. */
  .cue__chevron {
    display: block;
    animation: cue-nudge 1.9s var(--ease) infinite;
  }

  @keyframes cue-nudge {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    45% { transform: translateY(6px); opacity: 1; }
  }

  @keyframes cue-appear {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (hover: hover) {
    .cue:hover .cue__chevron { animation-play-state: paused; transform: translateY(4px); }
  }

  /* The label alone is enough when motion is unwelcome. */
  @media (prefers-reduced-motion: reduce) {
    .cue { animation: none; }
    .cue__chevron { animation: none; }
  }

  /* ----------------------------------------------------------------- bio */
  /* Width is limited on the paragraphs, not on the section — so the bio starts
     at the same left edge as everything else rather than floating in the
     middle of the page. */
  .bio__lead {
    font-family: var(--font-display);
    font-weight: 400;
    margin: 1.25rem 0 0;
    max-width: var(--measure);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--fg);
  }

  .bio__body {
    margin: 1rem 0 0;
    max-width: var(--measure);
    color: var(--fg-muted);
    font-size: 1rem;
  }

  /* ---------------------------------------------------------------- work */
  .work__grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  /* --------------------------------------------------------------- empty */
  .empty { padding-block: clamp(6rem, 22vh, 12rem); }
  .empty__title { font-size: clamp(1.75rem, 5vw, 2.75rem); }
  .empty__body { color: var(--fg-muted); max-width: var(--measure); }
  .empty__body code {
    background: var(--bg-raised);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  /* The parallax is decoration. Switch it off and the hero simply sits still. */
  /* The scroll cue is the only motion left in the hero — the pinning itself is
     plain scrolling, which reduced-motion does not object to. */</style>

