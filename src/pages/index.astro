---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Contact from '../components/Contact.astro';
import { CATEGORIES, SITE } from '../consts';
import { allPhotos, coverFor } from '../lib/photos';

const photos = allPhotos();
const hero = photos[0];

// The link-preview image: what renders when the Instagram bio link gets
// shared or unfurled elsewhere. 1200x630 is the size every platform crops to.
const og = hero
  ? await getImage({
      src: hero.src,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpg',
      quality: 76,
    })
  : undefined;
---

<Base ogImage={og?.src} navOverImage={Boolean(hero)}>
  {
    hero && (
      <section class="hero">
        <div class="hero__media">
          <Image
            src={hero.src}
            alt={hero.alt}
            widths={[640, 1024, 1600, 2000]}
            sizes="100vw"
            format="avif"
            quality={64}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class="hero__img"
          />
        </div>

        <div class="hero__scrim" />

        <div class="shell hero__content">
          <h1 class="hero__title">{SITE.title}</h1>
          <p class="hero__tagline">{SITE.tagline}</p>
        </div>

        <div class="hero__cue" aria-hidden="true">
          <span class="hero__cue-line" />
        </div>
      </section>
    )
  }

  {
    !hero && (
      <section class="shell empty">
        <h1 class="empty__title">No photos yet</h1>
        <p class="empty__body">
          Drop images into <code>src/photos/&lt;category&gt;/</code> and they appear here
          automatically.
        </p>
      </section>
    )
  }

  {/*
    Everything below the hero rides in one opaque slab. The hero is pinned
    behind it, so scrolling slides this over the photograph rather than
    scrolling the photograph away. The slab must be opaque and above the hero,
    or the pinned image shows through it.
  */}
  <div class="page-body">
  {/* Replace this text with your own — see src/pages/index.astro */}
  <section class="shell bio">
    <p class="eyebrow" data-reveal>About</p>
    <p class="bio__lead" data-reveal style="--reveal-delay:120ms">
      I'm an engineer in Paris who takes photos — mostly of
      animals, people, and whatever the outdoors puts in front of me.
    </p>
    <p class="bio__body" data-reveal style="--reveal-delay:220ms">
      The camera started as something to do on weekends and turned into the
      reason I go places. Most of what is here was taken on foot, without a
      plan, waiting for something to happen.
    </p>
  </section>

  <section class="shell work">
    <p class="eyebrow" data-reveal>Selected work</p>
    <div class="work__grid">
      {
        CATEGORIES.map((category, i) => (
          <CategoryCard
            category={category}
            path={[category.slug]}
            cover={coverFor([category.slug])}
            index={i}
          />
        ))
      }
    </div>
  </section>

  </div>

  {/* Rides in the layout's reveal block, behind the page. */}
  <Contact slot="reveal" />
</Base>

<style>
  /* ---------------------------------------------------------------- hero */
  /* Pinned to the top of the viewport for as long as the page scrolls past it,
     so the content below slides over the photograph instead of pushing it up.
     z-index 0 puts it behind .page-body. */
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    /* 100svh rather than vh: on mobile browsers vh includes the collapsing
       address bar, which makes the hero jump as you scroll. */
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
  }

  /* The slab that slides over the hero. Opaque, and above it. */
  .page-body {
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  .hero__media { position: absolute; inset: 0; }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-settle 1.6s var(--ease) both;
  }

  /* A slow, barely-there push in. Scale only — no layout cost. */
  @keyframes hero-settle {
    from { transform: scale(1.06); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  /* No beige melt any more — the page slides over the hero, so there is no
     edge to disguise. What is left only darkens the image enough for the white
     name and the nav links to stay readable over it. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(10, 9, 8, 0.58) 0%,
        rgba(10, 9, 8, 0.3) 34%,
        rgba(10, 9, 8, 0.06) 62%,
        transparent 82%
      ),
      linear-gradient(to bottom, rgba(10, 9, 8, 0.42) 0%, transparent 28%);
  }

  .hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(5rem, 16vh, 9rem);
    color: var(--on-image);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 9vw, 6.5rem);
    letter-spacing: -0.005em;
    line-height: 0.95;
    animation: rise 1s var(--ease) 0.25s both;
  }

  .hero__tagline {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--on-image-muted);
    animation: rise 1s var(--ease) 0.4s both;
  }

  @keyframes rise {
    from { opacity: 0; transform: translate3d(0, 24px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    width: 1px;
    height: 3rem;
    overflow: hidden;
    opacity: 0.55;
  }

  .hero__cue-line {
    display: block;
    width: 1px;
    height: 100%;
    background: var(--on-image);
    transform-origin: top;
    animation: cue 2.4s var(--ease) infinite;
  }

  @keyframes cue {
    0% { transform: scaleY(0) translateY(0); }
    40% { transform: scaleY(1) translateY(0); }
    100% { transform: scaleY(1) translateY(100%); }
  }

  /* ----------------------------------------------------------------- bio */
  .bio { padding-top: clamp(4rem, 14vh, 8rem); }

  /* Width is limited on the paragraphs, not on the section — so the bio starts
     at the same left edge as everything else rather than floating in the
     middle of the page. */
  .bio__lead {
    font-family: var(--font-display);
    font-weight: 400;
    margin: 1.25rem 0 0;
    max-width: var(--measure);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--fg);
  }

  .bio__body {
    margin: 1rem 0 0;
    max-width: var(--measure);
    color: var(--fg-muted);
    font-size: 1rem;
  }

  /* ---------------------------------------------------------------- work */
  .work { padding-top: clamp(4rem, 12vh, 7rem); }

  .work__grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  /* --------------------------------------------------------------- empty */
  .empty { padding-block: clamp(6rem, 22vh, 12rem); }
  .empty__title { font-size: clamp(1.75rem, 5vw, 2.75rem); }
  .empty__body { color: var(--fg-muted); max-width: var(--measure); }
  .empty__body code {
    background: var(--bg-raised);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  /* The parallax is decoration. Switch it off and the hero simply sits still. */
  /* The scroll cue is the only motion left in the hero — the pinning itself is
     plain scrolling, which reduced-motion does not object to. */
  @media (prefers-reduced-motion: reduce) {
    .hero__cue { display: none; }
  }
</style>

