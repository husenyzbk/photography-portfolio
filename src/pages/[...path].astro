---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { CATEGORIES, type Category } from '../consts';
import { photosIn, coverFor } from '../lib/photos';
import { href } from '../lib/url';

/**
 * One route per category, including nested ones — /people/ and
 * /people/portraits/ are both generated from the tree in consts.ts. Adding a
 * gallery there creates its page automatically.
 */
export function getStaticPaths() {
  const routes: {
    params: { path: string };
    props: { category: Category; segments: string[]; parent?: Category };
  }[] = [];

  for (const category of CATEGORIES) {
    routes.push({
      params: { path: category.slug },
      props: { category, segments: [category.slug] },
    });

    for (const child of category.children ?? []) {
      routes.push({
        params: { path: `${category.slug}/${child.slug}` },
        props: {
          category: child,
          segments: [category.slug, child.slug],
          parent: category,
        },
      });
    }
  }

  return routes;
}

const { category, segments, parent } = Astro.props;

const children = category.children ?? [];
const photos = children.length ? [] : photosIn(segments);
const cover = coverFor(segments);

const og = cover
  ? await getImage({
      src: cover.src,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpg',
      quality: 76,
    })
  : undefined;
---

<Base
  title={parent ? `${category.name} — ${parent.name}` : category.name}
  description={category.blurb}
  ogImage={og?.src}
>
  <header class="shell head">
    <nav class="crumbs" aria-label="Breadcrumb">
      {/* Back goes one level up — to the parent gallery if there is one,
          otherwise home. Home is always reachable separately. */}
      <a
        class="crumb crumb--back"
        href={parent ? href(parent.slug) : href()}
        data-press
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15">
          <path d="M15 4L7 12l8 8" stroke="currentColor" stroke-width="1.8" fill="none" />
        </svg>
        <span>{parent ? parent.name : 'Back'}</span>
      </a>

      <a class="crumb" href={href()} data-press>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15">
          <path
            d="M4 11l8-6.5 8 6.5M6.5 9.5V19h11V9.5"
            stroke="currentColor"
            stroke-width="1.6"
            fill="none"
            stroke-linejoin="round"
          />
        </svg>
        <span>Home</span>
      </a>
    </nav>

    <h1 class="head__title">{category.name}</h1>
    <p class="head__blurb">{category.blurb}</p>
  </header>

  {
    children.length > 0 && (
      <section class="shell sub">
        <div class="sub__grid">
          {children.map((child, i) => (
            <CategoryCard
              category={child}
              path={[category.slug, child.slug]}
              cover={coverFor([category.slug, child.slug])}
              index={i}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    children.length === 0 && photos.length > 0 && (
      <section class="gallery">
        <PhotoGrid photos={photos} />
        <Lightbox photos={photos} />
      </section>
    )
  }

  {
    children.length === 0 && photos.length === 0 && (
      <section class="shell empty">
        <p class="empty__body">
          Nothing here yet. Add images to{' '}
          <code>src/photos/{segments.join('/')}/</code> and they appear automatically.
        </p>
      </section>
    )
  }
</Base>

<style>
  .head {
    padding-top: clamp(2.5rem, 9vh, 5rem);
    padding-bottom: clamp(1.75rem, 5vh, 3rem);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--fg) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg) 8%, transparent);
    color: var(--fg-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease),
      transform var(--dur-press) var(--ease-press),
      filter var(--dur-press) var(--ease-press);
  }

  .crumb svg { display: block; flex: none; }

  @media (hover: hover) {
    .crumb:hover {
      color: var(--fg);
      background: color-mix(in srgb, var(--fg) 12%, transparent);
    }
  }

  /* The arrow slides back a touch on hover — a small cue that it moves you
     backwards through the site. */
  .crumb--back svg {
    transition: transform var(--dur-fast) var(--ease);
  }
  .crumb--back:hover svg { transform: translateX(-2px); }

  .head__title {
    font-size: clamp(2rem, 7vw, 4rem);
    letter-spacing: -0.03em;
  }

  .head__blurb {
    margin: 0.75rem 0 0;
    color: var(--fg-muted);
    max-width: var(--measure);
    font-size: 1rem;
  }

  /* The gallery runs edge to edge — a photo grid reads better full-bleed than
     boxed inside the text measure. */
  .gallery { padding-inline: clamp(0.375rem, 1.2vw, 0.75rem); }

  .sub__grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .empty { padding-block: clamp(3rem, 10vh, 6rem); }
  .empty__body { color: var(--fg-muted); max-width: var(--measure); }
  .empty__body code {
    background: var(--bg-raised);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }
</style>
