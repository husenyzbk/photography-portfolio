---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="footer">
  <hr class="rule" />
  <div class="shell footer__inner">
    <p class="footer__copy">© {year} {SITE.title}</p>
    <a class="footer__link" href={SITE.instagram} rel="me noopener" target="_blank">
      Instagram
    </a>
  </div>
</footer>

<style>
  .footer { margin-top: clamp(4rem, 12vh, 8rem); }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 2rem;
    /* Keeps the last line clear of the iPhone home indicator. */
    padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
  }

  .footer__copy,
  .footer__link {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .footer__link { transition: color var(--dur-fast) var(--ease); }
  .footer__link:hover { color: var(--fg); }
</style>
