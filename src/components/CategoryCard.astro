---
import { Image } from 'astro:assets';
import type { Category } from '../consts';
import type { Photo } from '../lib/photos';
import { photosIn } from '../lib/photos';
import { href } from '../lib/url';

interface Props {
  category: Category;
  /** Full path to the category, e.g. ['people','portraits']. */
  path: string[];
  cover?: Photo;
  index?: number;
}

const { category, path, cover, index = 0 } = Astro.props;
const count = photosIn(path).length;
// "0 photos" reads as a fault rather than as work in progress.
const label = count === 0 ? 'Coming soon' : count === 1 ? '1 photo' : `${count} photos`;
---

<a
  class="card"
  href={href(...path)}
  data-reveal
  data-press
  style={`--reveal-delay:${index * 90}ms`}
>
  <div class="card__media">
    {
      cover ? (
        <Image
          src={cover.src}
          alt=""
          widths={[400, 800, 1200]}
          sizes="(max-width: 46rem) 100vw, 33vw"
          format="avif"
          quality={62}
          loading="lazy"
          decoding="async"
          class="card__img"
        />
      ) : (
        <div class="card__placeholder" aria-hidden="true" />
      )
    }
  </div>

  <div class="card__body">
    <h2 class="card__title">
      {category.name}
      <span class="card__arrow" aria-hidden="true">→</span>
    </h2>
    <p class="card__blurb">{category.blurb}</p>
    <p class="card__count">{label}</p>
  </div>
</a>

<style>
  .card { display: block; }

  .card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bg-raised);
    /* Rounded here, but deliberately NOT on the photos inside a gallery —
       those sit edge to edge and rounding would break the grid. */
    border-radius: var(--radius);
  }

  .card__img,
  .card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }

  /* Shown when a gallery has no photographs yet. A quiet tint of the page,
     not the near-black this used to be — that was written for the original
     dark palette and read as a hole punched in the beige. */
  .card__placeholder {
    background:
      linear-gradient(140deg,
        color-mix(in srgb, var(--bg-raised) 70%, var(--bg)),
        var(--bg-raised));
    border: 1px solid color-mix(in srgb, var(--fg) 7%, transparent);
  }

  @media (hover: hover) {
    .card:hover .card__img { transform: scale(1.05); }
  }

  .card__body { padding-top: 1rem; }

  .card__title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .card__arrow {
    display: inline-block;
    color: var(--fg-faint);
    transform: translateX(-4px);
    opacity: 0;
    transition: transform var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
  }

  .card:hover .card__arrow,
  .card:focus-visible .card__arrow {
    transform: translateX(0);
    opacity: 1;
  }

  .card__blurb {
    margin: 0.35rem 0 0;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    max-width: 26rem;
  }

  .card__count {
    margin: 0.6rem 0 0;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
</style>
