---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../consts';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FloatingDock from '../components/FloatingDock.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative image used for link previews. */
  ogImage?: string;
  /** Lifts the nav onto the hero photograph — homepage only. */
  navOverImage?: boolean;
}

const { title, description, ogImage, navOverImage = false } = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const pageDesc = description ?? SITE.description;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, SITE.url).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ece5d9" />

    {/* The name in the hero is the first thing anyone reads, so its font is
        fetched in parallel with the stylesheet rather than after it. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/fonts/cormorant-garamond-300.woff2`}
      crossorigin
    />

    {/* Link previews — this is what renders when the Instagram bio link, or a
        DM of it, gets unfurled by another app. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav overImage={navOverImage} />

    <main id="main" class="page-main">
      <slot />
    </main>

    {/* Last in the stack, so it slides over the final pinned panel. */}
    <div class="page-end">
      <Footer />
    </div>

    <FloatingDock />

    <style>
      /* The panels inside pin themselves; main only needs to establish the
         stacking order relative to what follows it. */
      .page-main {
        position: relative;
        z-index: 1;
      }

      /* Above main, so it slides over the last pinned panel rather than being
         covered by it. Opaque for the same reason every panel is. */
      .page-end {
        position: relative;
        z-index: 2;
        background: var(--bg);
      }
    </style>

    <script>
      /**
       * Unpins any panel too tall to fit the screen.
       *
       * A pinned panel does not move, so anything inside it below the fold can
       * never be scrolled to — the page just carries on to the next panel and
       * that content is unreachable. This is only knowable by measuring: it
       * depends on the viewport, the font, and how the cards happen to wrap,
       * so no media query can express it.
       *
       * Runs again on resize, on rotation, and once images have loaded, since
       * every one of those changes a panel's height.
       */
      /*
        A panel that fits is exactly one viewport tall, because min-height: 100svh
        holds it there — so the test is only ever distinguishing "one screen"
        from "several screens", never anything marginal. The overflowing
        galleries panel measures around six screens.

        The comparison therefore needs generous slack. `100svh` and
        window.innerHeight are not the same number: svh is a CSS unit tracking
        the viewport with browser UI shown, innerHeight is the live window, and
        they disagreed by 28px here — enough that a tight threshold made the
        hero declare itself too tall and drop its pinning.
      */
      const OVERFLOW_SLACK = 64;

      const viewportHeight = () =>
        Math.max(window.innerHeight || 0, document.documentElement.clientHeight || 0);

      const syncPanels = () => {
        const panels = document.querySelectorAll('.panel');
        if (!panels.length) return;

        const limit = viewportHeight() + OVERFLOW_SLACK;

        for (const panel of panels) {
          // Measure without the class, or a panel that was unpinned last pass
          // keeps reporting its unpinned height and never pins again.
          panel.classList.remove('panel--flow');
          panel.classList.toggle('panel--flow', panel.scrollHeight > limit);
        }
      };

      let panelTick = false;
      const queuePanelSync = () => {
        if (panelTick) return;
        panelTick = true;
        requestAnimationFrame(() => {
          panelTick = false;
          syncPanels();
        });
      };

      syncPanels();
      window.addEventListener('resize', queuePanelSync, { passive: true });
      window.addEventListener('orientationchange', queuePanelSync, { passive: true });
      // Images arriving change panel heights, so measure again once they have.
      window.addEventListener('load', syncPanels);
      document.addEventListener('astro:page-load', syncPanels);
      // The display face lands after first paint and reflows the text it sets.
      if (document.fonts?.ready) document.fonts.ready.then(syncPanels);

      /**
       * Scroll reveal.
       *
       * One shared IntersectionObserver for the whole page rather than a
       * listener per element — a 60-photo gallery would otherwise thrash the
       * main thread on every scroll frame.
       */
      const setupReveal = () => {
        const targets = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (!targets.length) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) {
          targets.forEach((el) => el.classList.add('is-visible', 'reveal-done'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.classList.add('is-visible');
              el.addEventListener(
                'transitionend',
                () => el.classList.add('reveal-done'),
                { once: true },
              );
              io.unobserve(el);
            }
          },
          // Start the reveal slightly before the element reaches the viewport
          // so it is already settling by the time it is properly in view.
          { rootMargin: '0px 0px -8% 0px', threshold: 0.01 },
        );

        targets.forEach((el) => io.observe(el));
      };

      setupReveal();
      // Re-run after client-side navigation.
      document.addEventListener('astro:page-load', setupReveal);
    </script>
  </body>
</html>
