---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../consts';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FloatingDock from '../components/FloatingDock.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative image used for link previews. */
  ogImage?: string;
  /** Lifts the nav onto the hero photograph — homepage only. */
  navOverImage?: boolean;
}

const { title, description, ogImage, navOverImage = false } = Astro.props;

// Only pages that put something in the reveal slot — the homepage, with its
// contact form — get the full-screen reveal. On a gallery page the block holds
// nothing but the copyright, and giving that its own screen leaves a page of
// empty beige with one line floating in it.
const hasReveal = Astro.slots.has('reveal');

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const pageDesc = description ?? SITE.description;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, SITE.url).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ece5d9" />

    {/* The name in the hero is the first thing anyone reads, so its font is
        fetched in parallel with the stylesheet rather than after it. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL.replace(/\/+$/, '')}/fonts/cormorant-garamond-300.woff2`}
      crossorigin
    />

    {/* Link previews — this is what renders when the Instagram bio link, or a
        DM of it, gets unfurled by another app. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav overImage={navOverImage} />

    {/*
      The page proper. Opaque and above the reveal block, so it covers it until
      it is scrolled off — that covering is what makes the reveal work.
    */}
    <main id="main" class="page-main">
      <slot />
    </main>

    {/*
      Pinned to the bottom of the viewport, behind the page. Scrolling slides
      the page up off it rather than scrolling it into view — the same idea as
      the hero, mirrored.
    */}
    <div class:list={['reveal', { 'reveal--full': hasReveal }]}>
      <slot name="reveal" />
      <Footer />
    </div>

    <FloatingDock />

    <style>
      .page-main {
        position: relative;
        z-index: 1;
        background: var(--bg);
      }

      /* `bottom: 0` keeps this block's bottom edge at the viewport bottom for
         as long as its natural position would be below the fold — so it is
         already sitting there, hidden behind the page, and is uncovered as the
         page scrolls up off it.

         It must be exactly one screen tall. Pinning the bottom of a block that
         is taller than the viewport pushes its top off the top of the screen,
         which hides the contact form and reveals only the footer. */
      .reveal {
        z-index: 0;
      }

      /* Only attempt the reveal when a screen is tall enough to hold the form
         and the footer at once. On a short screen it falls back to an ordinary
         section at the end of the page, which always works. */
      @media (min-height: 40rem) {
        .reveal--full {
          position: sticky;
          bottom: 0;
          min-height: 100svh;
          display: flex;
          flex-direction: column;
          justify-content: center;
        }

        /* The footer settles at the bottom of that screen, the form sits above
           it in the remaining space. */
        .reveal--full > :last-child { margin-top: auto; }

        /* The section's own top padding is what pushed the block past one
           screen, which left its heading stranded above the viewport during
           the reveal. Centring in the flex column already provides the
           breathing room, so the padding is not needed here. */
        .reveal--full :global(.contact) { padding-top: 0; }
      }
    </style>

    <script>
      /**
       * Scroll reveal.
       *
       * One shared IntersectionObserver for the whole page rather than a
       * listener per element — a 60-photo gallery would otherwise thrash the
       * main thread on every scroll frame.
       */
      const setupReveal = () => {
        const targets = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (!targets.length) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) {
          targets.forEach((el) => el.classList.add('is-visible', 'reveal-done'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.classList.add('is-visible');
              el.addEventListener(
                'transitionend',
                () => el.classList.add('reveal-done'),
                { once: true },
              );
              io.unobserve(el);
            }
          },
          // Start the reveal slightly before the element reaches the viewport
          // so it is already settling by the time it is properly in view.
          { rootMargin: '0px 0px -8% 0px', threshold: 0.01 },
        );

        targets.forEach((el) => io.observe(el));
      };

      setupReveal();
      // Re-run after client-side navigation.
      document.addEventListener('astro:page-load', setupReveal);
    </script>
  </body>
</html>
